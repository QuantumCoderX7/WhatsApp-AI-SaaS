# =============================================================================
# WHATSAPP AI AUTOMATION PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development                # development, staging, production
PROJECT_NAME="WhatsApp AI SaaS"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours

# -----------------------------------------------------------------------------
# PostgreSQL Database (Supabase / Local pgvector)
# -----------------------------------------------------------------------------
# Local Docker setup or Supabase connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_saas
# Sync URL for Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/whatsapp_saas

# -----------------------------------------------------------------------------
# Redis (Upstash / Local Redis)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_SSL=false
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Google AI Studio (Gemini API)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash           # gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API Settings
# -----------------------------------------------------------------------------
META_VERIFY_TOKEN=your_meta_webhook_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
META_API_VERSION=v18.0

# -----------------------------------------------------------------------------
# Supabase Storage & RLS (POC / Production)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=knowledge-documents

# -----------------------------------------------------------------------------
# Frontend Next.js Public Environment Variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
